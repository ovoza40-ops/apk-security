<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️ Himoya Tizimi"
        android:textColor="#ff0033"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etTargetPackage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nishon ilova nomi (masalan: qoriqchi)"
        android:textColor="#ffffff"
        android:textColorHint="#888888"
        android:text="qoriqchi"
        android:backgroundTint="#ff0033"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nomni saqlash"
        android:backgroundTint="#333333"
        android:textColor="#ffffff"
        android:layout_marginBottom="14dp" />

    <Button
        android:id="@+id/btnPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Xizmatga ruxsat berish"
        android:backgroundTint="#ff0033"
        android:textColor="#ffffff" />
</LinearLayout>
